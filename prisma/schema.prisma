generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  password          String
  passwordChangedAt DateTime? @db.Timestamptz(3) // sessions issued before this instant are rejected
  name              String
  roleId            String
  role              Role      @relation(fields: [roleId], references: [id])
  branchId          String?
  branch            Branch?   @relation(fields: [branchId], references: [id])
  shifts            Shift[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // ADMIN, CASHIER, SUPERVISOR
  permissions String[]
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Branch {
  id        String     @id @default(uuid())
  name      String
  address   String?
  users     User[]
  registers Register[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Register {
  id         String   @id @default(uuid())
  name       String // e.g. "Caja Principal"
  prefix     String? // Facturation prefix
  nextNumber Int      @default(1) // next consecutive receipt number for this register
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id])
  shifts     Shift[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Shift {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  registerId  String
  register    Register     @relation(fields: [registerId], references: [id])
  baseAmount  Float        @default(0)
  closeAmount Float?
  status      String       @default("OPEN") // OPEN, CLOSED
  startTime   DateTime     @default(now())
  endTime     DateTime?
  sales       Sale[]
  subAccounts SubAccount[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Category {
  id        String    @id @default(uuid())
  name      String
  sortOrder Int       @default(0) // New: For POS custom ordering left-to-right
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// A promotion-matching group across variants/flavors of the same line (e.g.
/// "Buldak" covers every flavor as separate Products) — see Product.familyId.
model ProductFamily {
  id                 String               @id @default(uuid())
  name               String               @unique
  products           Product[]
  promoConditions    PromotionCondition[]
  promoEffectTargets PromotionEffect[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

/// A rule that automatically adjusts a sale when its conditions are met —
/// "buy X get Y free", "X+Y for a fixed combo price", "X unlocks Y at N% off".
/// Applied transparently by the cart engine (app/lib/promotions.ts): the
/// cashier never activates it manually. Promotions don't stack — at most one
/// applies per sale (the highest-priority one whose conditions are met), and
/// a promo being active blocks the manual order-level discount.
model Promotion {
  id         String               @id @default(uuid())
  name       String
  isActive   Boolean              @default(true)
  startDate  DateTime?
  endDate    DateTime?
  /// Lower number wins when more than one promotion's conditions are met.
  priority   Int                  @default(0)
  conditions PromotionCondition[]
  effect     PromotionEffect?
  sales      Sale[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([isActive])
}

/// One "must have at least N of this" requirement. A promotion's conditions
/// are AND'ed together — all must be met. Matches either one specific
/// product OR an entire family ("any Buldak flavor"), never both.
model PromotionCondition {
  id          String         @id @default(uuid())
  promotionId String
  promotion   Promotion      @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?       @relation("PromotionConditionProduct", fields: [productId], references: [id])
  familyId    String?
  family      ProductFamily? @relation(fields: [familyId], references: [id])
  minQuantity Float          @default(1)
}

/// What happens when a promotion's conditions are met. One effect per
/// promotion (kept singular deliberately — a promotion is one rule, not a
/// bundle of adjustments). `targetType` decides what `value` discounts:
/// - CONDITION_ITEMS: the very items that satisfied the conditions (the
///   combo itself) — e.g. "X+Y for a fixed $30.000".
/// - PRODUCT / FAMILY: a companion item elsewhere in the cart, which must
///   also be present — e.g. "X unlocks Y at 20% off".
model PromotionEffect {
  id              String         @id @default(uuid())
  promotionId     String         @unique
  promotion       Promotion      @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  type            String // FREE_ITEM | FIXED_PRICE | PERCENT_OFF | AMOUNT_OFF
  targetType      String // CONDITION_ITEMS | PRODUCT | FAMILY
  targetProductId String?
  targetProduct   Product?       @relation("PromotionEffectProduct", fields: [targetProductId], references: [id])
  targetFamilyId  String?
  targetFamily    ProductFamily? @relation(fields: [targetFamilyId], references: [id])
  /// Percent (0-100) for PERCENT_OFF, COP for FIXED_PRICE/AMOUNT_OFF, unused for FREE_ITEM.
  value           Float?
  /// How many units of the target get the effect. Unused for CONDITION_ITEMS
  /// (the condition's own minQuantity rows already say how many).
  targetQuantity  Float          @default(1)
}

model Product {
  id                 String               @id @default(uuid())
  name               String
  code               String               @unique
  description        String?
  price              Float
  cost               Float                @default(0)
  stock              Float                @default(0)
  taxIva             Float                @default(0) // Percentage (e.g., 0, 5, 19)
  taxIca             Float                @default(0) // Percentage (e.g., 0, 1)
  taxImpoConsumo     Float                @default(0) // Percentage (e.g., 0, 8)
  categoryId         String?
  category           Category?            @relation(fields: [categoryId], references: [id])
  // Lightweight grouping used ONLY by promotions ("any Buldak flavor"), kept
  // separate from Category because Category drives how the POS browses the
  // catalog (e.g. "Snacks") and mixing the two would force an awkward
  // category per brand/line. Optional: most products aren't in any promo.
  familyId           String?
  family             ProductFamily?       @relation(fields: [familyId], references: [id])
  /// Which bulk insumo (see RawMaterial) this product is made from, e.g.
  /// "Café Americano" -> "Café en grano". One insumo per product — good
  /// enough to answer "what did we sell while this batch of coffee lasted"
  /// without building a full multi-ingredient recipe/BOM.
  rawMaterialId      String?
  rawMaterial        RawMaterial?         @relation(fields: [rawMaterialId], references: [id])
  imageUrl           String? // Already existed
  isFavorite         Boolean              @default(false)
  isActive           Boolean              @default(true)
  // SIMPLE: just `stock`, no lots (default, most products).
  // LOT: health-authority traceability — every receipt creates a ProductLot
  // (lot number + optional expiration), sales consume FEFO automatically.
  // NONE: not stock-tracked at all (e.g. coffee-by-the-cup, soft-serve).
  trackingMode       String               @default("SIMPLE")
  saleDetails        SaleDetail[]
  movements          StockMovement[]
  lots               ProductLot[]
  promoConditions    PromotionCondition[] @relation("PromotionConditionProduct")
  promoEffectTargets PromotionEffect[]    @relation("PromotionEffectProduct")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

/// One receipt of a lot-tracked product (e.g. one case of Buldak ramen).
/// `quantityRemaining` is decremented FEFO as sales consume it; a lot with
/// 0 remaining is exhausted but kept for traceability, never deleted.
model ProductLot {
  id                String          @id @default(uuid())
  productId         String
  product           Product         @relation(fields: [productId], references: [id])
  lotNumber         String? // as printed by the manufacturer; optional (some suppliers don't print one)
  expirationDate    DateTime?       @db.Date // optional: alcohol has a lot but no expiration
  receivedDate      DateTime        @default(now())
  quantityReceived  Float
  quantityRemaining Float
  supplierId        String?
  supplier          Supplier?       @relation(fields: [supplierId], references: [id])
  movements         StockMovement[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([productId, expirationDate])
  @@index([expirationDate])
}

/// Who a lot (product or raw material) was received from. Optional on every
/// lot — traceability wants it recorded when known, but doesn't require it.
model Supplier {
  id              String           @id @default(uuid())
  name            String
  taxId           String?
  phone           String?
  email           String?
  address         String?
  notes           String?
  isActive        Boolean          @default(true)
  productLots     ProductLot[]
  rawMaterialLots RawMaterialLot[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

/// Bulk ingredient log (coffee beans, soft-serve mix) for products that are
/// sold without per-unit inventory (Product.trackingMode = "NONE"). Deliberately
/// NOT linked to sales — building recipe/BOM consumption per cup would be far
/// more than the health-traceability requirement actually asks for. Registering
/// a new lot for the same RawMaterial auto-marks the previous one DEPLETED.
model RawMaterial {
  id        String           @id @default(uuid())
  name      String           @unique // e.g. "Café en grano", "Mezcla de helado"
  lots      RawMaterialLot[]
  products  Product[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model RawMaterialLot {
  id             String      @id @default(uuid())
  rawMaterialId  String
  rawMaterial    RawMaterial @relation(fields: [rawMaterialId], references: [id])
  lotNumber      String?
  expirationDate DateTime?   @db.Date
  receivedDate   DateTime    @default(now())
  status         String      @default("ACTIVE") // ACTIVE | DEPLETED
  notes          String?
  createdById    String?
  supplierId     String?
  supplier       Supplier?   @relation(fields: [supplierId], references: [id])
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([rawMaterialId, status])
  @@index([expirationDate])
}

/// Kardex: every change to Product.stock, with the balance after it.
model StockMovement {
  id         String      @id @default(uuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id])
  type       String // SALE | CANCEL | PURCHASE | ADJUSTMENT | WASTE | IMPORT
  quantity   Float // signed: negative leaves stock, positive enters
  stockAfter Float
  unitCost   Float? // for PURCHASE: cost paid per unit
  reason     String?
  saleId     String?
  userId     String?
  lotId      String?
  lot        ProductLot? @relation(fields: [lotId], references: [id])
  createdAt  DateTime    @default(now())

  @@index([productId, createdAt])
  @@index([createdAt])
  @@index([lotId])
}

model Customer {
  id         String   @id @default(uuid())
  documentId String?  @unique
  fullName   String
  email      String?
  phone      String?
  sales      Sale[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Sale {
  id            String       @id @default(uuid())
  shiftId       String
  shift         Shift        @relation(fields: [shiftId], references: [id])
  customerId    String?
  customer      Customer?    @relation(fields: [customerId], references: [id])
  number        Int? // consecutive per register (prefix-number on the receipt)
  total         Float
  discount      Float        @default(0)
  /// The one promotion that auto-applied to this sale, if any (promotions
  /// don't stack). Name is a snapshot, same reasoning as SaleDetail.productName
  /// — survives the promotion being edited or deleted later.
  promotionId   String?
  promotion     Promotion?   @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  promotionName String?
  status        String       @default("COMPLETED") // COMPLETED, SUSPENDED, CANCELLED
  source        String       @default("POS") // POS | SIIGO (imported)
  /// Client-generated idempotency key (crypto.randomUUID()), set only by the
  /// offline-retry queue (see app/lib/offlineSalesQueue.ts): the POS can
  /// lose the network mid-checkout and retry the same submission once
  /// reconnected — this lets the server recognize a retry of a sale it
  /// already created instead of registering it twice.
  clientRef     String?      @unique
  externalRef   String? // e.g. Siigo invoice number
  cancelledAt   DateTime?
  cancelledById String?
  cancelReason  String?
  details       SaleDetail[]
  payments      Payment[]
  subAccounts   SubAccount[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([source, externalRef])
  @@index([createdAt])
}

model SubAccount {
  id        String   @id @default(uuid())
  shiftId   String
  shift     Shift    @relation(fields: [shiftId], references: [id])
  label     String
  items     Json
  total     Float
  paid      Boolean  @default(false)
  saleId    String?
  sale      Sale?    @relation(fields: [saleId], references: [id])
  createdAt DateTime @default(now())
}

model SaleDetail {
  id                   String   @id @default(uuid())
  saleId               String
  sale                 Sale     @relation(fields: [saleId], references: [id])
  productId            String
  product              Product  @relation(fields: [productId], references: [id])
  productName          String   @default("") // snapshot at time of sale
  productCode          String   @default("")
  quantity             Float
  unitPrice            Float // Base unit price at the time of sale
  taxIvaAmount         Float    @default(0) // Calculated IVA amount per unit * quantity
  taxIcaAmount         Float    @default(0) // Calculated ICA amount per unit * quantity
  taxImpoConsumoAmount Float    @default(0) // Calculated ImpoConsumo amount per unit * quantity
  discount             Float    @default(0) // COP discount applied to this line (own + prorated order discount)
  subtotal             Float // (unitPrice * quantity - discount) + total taxes
  createdAt            DateTime @default(now())
}

model Payment {
  id              String   @id @default(uuid())
  saleId          String
  sale            Sale     @relation(fields: [saleId], references: [id])
  method          String // CASH, CARD, TRANSFER
  amount          Float
  status          String   @default("PAID")
  /**
   * Which subaccount (person) made this payment, for split-bill sales — printed on the receipt as a per-person breakdown. Null for a regular (non-split) sale.
   */
  subAccountLabel String?
  createdAt       DateTime @default(now())
}

model SystemConfig {
  id    String @id @default(uuid())
  key   String @unique
  value String
}
