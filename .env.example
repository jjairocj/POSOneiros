# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

# PostgreSQL (local o gestionado: Neon, Supabase, Railway…)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/oneirospos?schema=public"

# Si usas Neon: usa el connection string "Pooled" (host con "-pooler") aquí —
# es el que debe usar la app en producción (serverless = muchas conexiones
# cortas). Para comandos puntuales de Prisma (`prisma migrate deploy/dev`,
# scripts de admin) usa en su lugar el endpoint SIN "-pooler" (Direct
# connection): el pooler de Neon reutiliza sesiones entre clientes, y una
# herramienta que cambie el `search_path` en su sesión puede dejarlo mal
# para la siguiente conexión que reutilice ese mismo backend. Ejemplo:
#   npx prisma migrate deploy  # ejecutar así, sobreescribiendo la var:
#   DATABASE_URL="<direct, sin -pooler>" npx prisma migrate deploy

# Secreto para firmar sesiones. Genera uno distinto por ambiente:
#   openssl rand -base64 32
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# URL pública de la app (sin barra final). En Vercel puedes omitirla.
NEXTAUTH_URL="http://localhost:3000"

# Solo para el seed inicial (npm run db:seed). Se borra después del primer login.
SEED_ADMIN_EMAIL="admin@tunegocio.com"
SEED_ADMIN_PASSWORD="cambia-esta-clave"
